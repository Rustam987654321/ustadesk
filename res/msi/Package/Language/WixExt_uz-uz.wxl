	<!-- Firewall Extension needs translation here -->
	<String Id="msierrFirewallCannotConnect" Overridable="yes" Value="Windows Firewall'ga ulanib bo'lmadi. ([2]   [3]   [4]   [5])" />

	<String Id="WixSchedFirewallExceptionsInstall" Overridable="yes" Value="Windows Firewall sozlanmoqda" />
	<String Id="WixSchedFirewallExceptionsUninstall" Overridable="yes" Value="Windows Firewall sozlanmoqda" />
	<String Id="WixRollbackFirewallExceptionsInstall" Overridable="yes" Value="Windows Firewall sozlamalari orqaga qaytarilmoqda" />
	<String Id="WixExecFirewallExceptionsInstall" Overridable="yes" Value="Windows Firewall sozlamalari o'rnatilmoqda" />
	<String Id="WixRollbackFirewallExceptionsUninstall" Overridable="yes" Value="Windows Firewall sozlamalari orqaga qaytarilmoqda" />
	<String Id="WixExecFirewallExceptionsUninstall" Overridable="yes" Value="Windows Firewall sozlamalari olib tashlanmoqda" />

	<!-- Util Extension does not need translation here, because it is already in official WiX Toolkit -->
